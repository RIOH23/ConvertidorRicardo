<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ConvertidorRicardo"
             x:Class="ConvertidorRicardo.AppFlyoutPage"
             Title= "Opciones"
            FlyoutLayoutBehavior="Popover">

    <FlyoutPage.Flyout>
        <ContentPage
            Title="Opciones"
            BackgroundColor="{DynamicResource PageBackgroundColor}">
            <VerticalStackLayout
                Padding="10,40,10,10"
                Spacing="20">
                <Label
                    Text="Opciones"
                    FontSize="24"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />
                <Button
                    Text="Calculadora"
                    Clicked="OnCalculadoraClicked" />
                <Button
                    Text="Convertidor"
                    Clicked="OnConvertidorClicked" />
            </VerticalStackLayout>
        </ContentPage>
    </FlyoutPage.Flyout>

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <local:MainPage />
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>